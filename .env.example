# TREND AI CRYPTO PRO — server-side AI configuration.
# Copy to .env and fill in. NEVER commit .env; the key stays out of the browser.

# Any OpenAI-compatible provider works (OpenAI, OpenRouter, Groq, local Ollama...).
# Leave AI_API_KEY empty to run without an AI provider: the frontend then
# automatically falls back to the built-in local analysis engine.

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional overrides
# AI_TIMEOUT_MS=30000
# PORT=8090
