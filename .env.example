# TREND AI CRYPTO PRO — server-side configuration
# Copy to .env and fill in. NEVER commit .env — these keys stay out of the browser.
# serve.js reads this file at boot; nothing here is ever sent to the client.

## AI provider (chat copilot + trading agent decisions)
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, local Ollama / LM Studio.
# With AI_API_KEY empty the chat falls back to the built-in local analysis engine,
# and the trading agent refuses to trade (paper mode may use the rule engine).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=30000

## Binance spot (only needed for testnet / live trading)
# Create read+trade keys, and DISABLE withdrawals. Restrict the key by IP if you can.
# Paper mode needs no key at all — it reads Binance public tickers.
BINANCE_API_KEY=
BINANCE_API_SECRET=

## Protect the /api/agent/* endpoints
# Without a token, agent endpoints answer loopback clients only (127.0.0.1).
# Set one if you ever expose the app beyond localhost; the browser must then send
# it as the x-agent-token header.
# AGENT_API_TOKEN=

## Server
# PORT=8090
